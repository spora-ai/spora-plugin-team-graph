{
    "name": "spora-ai/spora-plugin-team-graph",
    "description": "Per-principal directed graph of agent spawning relationships, rendered in the admin SPA via Mermaid.",
    "type": "spora-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "spora-ai/spora-core": ">=0.23.0 <2.0.0 || @dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Spora\\Plugins\\TeamGraph\\": "src/"
        },
        "files": [
            "routes/team-graph.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Spora\\Plugins\\TeamGraph\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:parallel": "pest --parallel --processes=auto --max-batch-size=50",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "lint": "php-cs-fixer fix --dry-run --diff --no-interaction",
        "format": "php-cs-fixer fix --no-interaction"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "spora-ai/installer": true
        },
        "preferred-install": {
            "spora-ai/spora-core": "source",
            "spora-ai/spora-plugin-team-graph-frontend": "source"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/spora-ai/spora-core.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
