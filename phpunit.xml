<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <!--
        Without this block PHPUnit has no filter and skips coverage
        entirely: it logs "No filter is configured, code coverage will
        not be processed", writes no clover report, and still exits 0 —
        so the coverage job would upload nothing and Sonar would ingest
        no data while both looked green.

        `routes` is a source directory, not a test one: team-graph.php
        declares the route path and its middleware on the request
        surface, and phpstan.neon already analyses it.
    -->
    <source>
        <include>
            <directory>src</directory>
            <directory>routes</directory>
        </include>
    </source>
</phpunit>
